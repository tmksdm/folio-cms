{
  "name": "folio-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "check": "node --check src/auth.js && node --check src/worker.js && node --check src/ui.js && node --check tests/preview-server.js && node --check tests/browser-check.js",
    "test": "node --test tests/*.test.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "preview:test": "node tests/preview-server.js"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "wrangler": "4.149.0"
  }
}
